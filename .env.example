# ONE Claire runtime
PORT=8787

# Optional Salesforce connection. Without these, ONE Claire runs in mock mode.
SALESFORCE_INSTANCE_URL=https://your-domain.my.salesforce.com
SALESFORCE_ACCESS_TOKEN=replace-me
SALESFORCE_API_VERSION=v61.0
SALESFORCE_ENRICHMENT_OBJECT=AI_Knowledge_Enrichment__c

# Optional OpenAI-compatible LLM. Without this, ONE Claire uses the local deterministic draft generator.
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
